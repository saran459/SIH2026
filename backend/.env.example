# AICTE SmartApproval Configuration
PROJECT_NAME="AICTE SmartApproval"
ENVIRONMENT="development"
SECRET_KEY="aicte-smartapproval-secret-key-change-in-production-smart-india-hackathon-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (MySQL 8)
# If MySQL is not reachable, the system will fall back to local SQLite for tests/offline
DATABASE_URL="mysql+pymysql://root:12345@localhost:3306/aicte_smartapproval"
SQL_ECHO=False

# File Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=15728640  # 15MB

# CORS Origins (Institution on 5173, Reviewer on 5174)
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174", "http://localhost:8000", "http://127.0.0.1:8000", "https://institution.example.com", "https://reviewer.example.com", "https://api.example.com"]

# Notification & SMTP (Optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@aicte-india.org"
