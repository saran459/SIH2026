{
  "name": "aicte-smartapproval-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:institution": "npm --workspace=apps/institution-portal run dev",
    "dev:reviewer": "npm --workspace=apps/reviewer-portal run dev",
    "build:institution": "npm --workspace=apps/institution-portal run build",
    "build:reviewer": "npm --workspace=apps/reviewer-portal run build",
    "build:all": "npm run build --workspaces"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
